{
  // ドキュメントの markdown lint 設定。
  //
  // 方針: 構造の壊れ（見出し・リスト・コードブロックの体裁）は検出し、
  //       日本語ドキュメントで機械的に守れない表記ルールは無効化する。
  //       「守れないルールは有効にしない・警告ゼロを維持する」
  //       — .claude/rules/static-analysis.md
  "config": {
    "default": true,

    // MD013: 日本語は 80 桁折り返しを前提にできない。
    // 単語境界がなく任意位置で改行できてしまうため、機械的な行長制限は
    // 「読みやすさ」と対応しない。仕様書の表も 1 行が長くなる。
    "MD013": false,

    // MD024: 仕様書では章ごとに「## 概要」「## 検証」等の同名見出しが繰り返し現れる。
    "MD024": false,

    // MD029: 手順書で番号を振り直すことがあり、連番の強制は実務に合わない。
    "MD029": false,

    // MD033: バッジ・詳細折りたたみ（<details>）で HTML を使う。
    "MD033": false,

    // MD034: issue / PR の URL をそのまま貼る運用のため。
    "MD034": false,

    // MD041: .claude/rules/ の各ファイルは frontmatter から始まる。
    "MD041": false,

    // MD051: 見出しアンカーの実在チェックは scripts/check-md-anchors.cjs が担当する。
    // MD051 のアンカー生成規則は GitHub 本体と一致せず、判定が食い違う。
    // 実例: `### ① ログイン開始` の実アンカーは GitHub では `#-ログイン開始`
    //（`①` が除去され先頭がハイフンになる。レンダリング後の HTML で
    // `id="user-content--ログイン開始"` を確認済み）だが、MD051 は `①` を残すため
    // 「正しいリンクを不正と判定し、壊れたリンクを見逃す」二重の誤りになる。
    // 検査スクリプトは GitHub と同じ github-slugger を使い、
    // 同一ファイル内に加えてファイル間のアンカー（file.md#anchor）も検査する
    // ため、MD051 の上位互換になっている（issue #137）。
    // — static-analysis.md「役割分担（重ねない）」
    "MD051": false,

    // MD060: テーブルの桁揃え（パイプ位置の空白調整）は純粋な見た目であり、
    // Formatter の領分。手書きの表に対して機械的な整形を強制しない。
    // — static-analysis.md「見た目に関する Linter ルールを有効にしない」
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // base/ は別プロジェクトの参考実装のため対象外。
    "base/**",
    "front/test-results/**",
    "front/playwright-report/**"
  ]
}
